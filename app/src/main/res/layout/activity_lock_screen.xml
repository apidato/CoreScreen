<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLockLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- SALUDO -->
    <TextView
        android:id="@+id/txtNombreDuenio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola Ilmer,"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- FECHA -->
    <TextView
        android:id="@+id/txtFechaBloqueo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="hoy es cargando..."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="28dp" />

    <!-- CONTENEDOR DEL RELOJ -->
    <FrameLayout
        android:id="@+id/contenedorReloj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="36dp">

        <TextView
            android:id="@+id/txtRelojBloqueo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#00FF00"
            android:textSize="48sp"
            android:fontFamily="sans-serif-light"
            android:textStyle="bold"
            android:gravity="center" />
    </FrameLayout>

    <!-- FLECHITA DE DESBLOQUEO -->
    <TextView
        android:id="@+id/txtDesbloquear"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:text="➔"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:background="@drawable/burbuja_app"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>