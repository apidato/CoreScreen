<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp"
    android:paddingTop="12dp">

    <!-- BARRA SUPERIOR (Icono de Ajustes y Batería) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnIconConfig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cfg_titulo"
            android:textColor="#FFFFFF"
            android:gravity="start"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtBateria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:gravity="end" />
    </LinearLayout>

    <!-- NOMBRE DEL DISPOSITIVO -->
    <TextView
        android:id="@+id/txtDispositivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dispositivo"
        android:textColor="#888888"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- WIDGET CENTRAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView android:id="@+id/txtRelojWidget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="64sp" android:fontFamily="sans-serif-light" android:textStyle="bold" />
        <TextView android:id="@+id/txtFechaWidget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando fecha..." android:textColor="#888888" android:textSize="14sp" android:fontFamily="sans-serif" android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- FAVORITOS -->
    <LinearLayout
        android:id="@+id/layoutFavoritos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="20dp">
    </LinearLayout>

    <!-- BUSCADOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/burbuja_app"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/inputTerminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="@string/hint_buscar"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- LISTA DE APPS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutListaApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        </LinearLayout>
    </ScrollView>

</LinearLayout>